[Unit]
Description=ToadAid Knowledge Forge generic agent request socket

[Socket]
ListenStream=/run/toadaid-knowledge-forge/agent-requests.sock
Accept=yes
Service=knowledge-forge-operator@.service
SocketUser=kf-operator
SocketGroup=kf-agent
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
