[Unit]
Description=ToadAid Knowledge Forge protected promotion ceremony
Requires=knowledge-forge-operator.socket
After=knowledge-forge-operator.socket

[Service]
Type=exec
RuntimeMaxSec=10min
User=kf-operator
Group=kf-operator
UMask=0077
StandardInput=socket
StandardOutput=socket
StandardError=journal
ExecStart=/opt/toadaid-kf-operator/bin/knowledge-forge-protected-operator serve-connection
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/toadaid-kf-operator
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
