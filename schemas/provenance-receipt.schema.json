{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toadaid.org/knowledge-forge/provenance-receipt.schema.json",
  "title": "Knowledge Forge ProvenanceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "skill_version",
    "knowledge_id",
    "candidate_sha256",
    "source_ids",
    "compiler",
    "artifact_hashes",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.6"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^knowledge-forge:"
    },
    "skill_version": {
      "type": "integer",
      "minimum": 1
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "adapter_id",
        "compiler_profile_id",
        "compiler_digest",
        "compiler_version",
        "model_identity",
        "prompt_template_hash",
        "parameters"
      ],
      "properties": {
        "contract_version": {
          "const": "0.2"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "compiler_profile_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compiler_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1
        },
        "model_identity": {
          "type": "string",
          "minLength": 1
        },
        "prompt_template_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
