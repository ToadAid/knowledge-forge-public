{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toadaid.org/knowledge-forge/normalized-source.schema.json",
  "title": "Knowledge Forge NormalizedSource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "extractor",
    "normalized_text_sha256",
    "line_count",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "source_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalized_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "line_count": {
      "type": "integer",
      "minimum": 0
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "heading",
          "ordinal",
          "text",
          "anchor",
          "section_sha256",
          "section_byte_length"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^s[0-9]{3,}$"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ]
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "start_line",
              "end_line"
            ],
            "properties": {
              "kind": {
                "const": "line_range"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "section_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "section_byte_length": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
