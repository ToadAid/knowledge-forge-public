{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toadaid.org/knowledge-forge/skill-registry.schema.json",
  "title": "Knowledge Forge Skill Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "updated_at", "skills"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["current_version", "versions"],
        "properties": {
          "current_version": {"type": "integer", "minimum": 1},
          "versions": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[1-9][0-9]*$"},
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill_id",
                "skill_version",
                "state",
                "authority",
                "title",
                "purpose",
                "source_ids",
                "package_receipt_sha256",
                "package_ref",
                "lifecycle_head_sha256",
                "registered_at",
                "lifecycle_record"
              ],
              "properties": {
                "skill_id": {"type": "string", "minLength": 1},
                "skill_version": {"type": "integer", "minimum": 1},
                "state": {"enum": ["PROMOTED", "SUPERSEDED"]},
                "authority": {"const": "KNOWLEDGE_ONLY"},
                "title": {"type": "string", "minLength": 1},
                "purpose": {"type": "string", "minLength": 1},
                "source_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "package_receipt_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "package_ref": {
                  "type": "string",
                  "pattern": "^receipt:sha256:[0-9a-f]{64}$"
                },
                "lifecycle_head_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "registered_at": {"type": "string", "minLength": 1},
                "lifecycle_record": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
